{
  "id": "/?source=pwa",
  "name": "DSMS • Departmental Society Management System",
  "short_name": "DSMS",
  "description": "Next-Generation University Society Governance, Student Portals, Events & Credential Verification Hub",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "categories": ["education", "productivity", "social"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Student Portal",
      "short_name": "Student",
      "description": "Access your profile, memberships, and co-curricular transcript",
      "url": "/student-dashboard",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "President Portal",
      "short_name": "President",
      "description": "Executive society operations, approvals, and member roster",
      "url": "/president-dashboard",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Campus Events",
      "short_name": "Events",
      "description": "Browse upcoming events, workshops, and registrations",
      "url": "/events",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Verify Credentials",
      "short_name": "Verify",
      "description": "Instantly verify certificates, membership badges, and tickets",
      "url": "/verify",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
